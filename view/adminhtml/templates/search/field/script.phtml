<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\AdminSimpleSearchFields\ViewModel\FieldInterface;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var FieldInterface $field */
$field = $block->getField();
$provider = $block->getProvider();
$fieldValue = $block->getValue();
$gridLabel = $field->getGridLabel();
$fieldName = $block->getFieldName() ?? $field->getFieldName();
$fieldId = (string)$block->getRequest()->getParam('field_id');
$modalId = $fieldName . '-search-modal';
$searchAjaxUrl = $block->getUrl($field->getSearchAjaxUrl(), [
    'field_id' => $fieldName,
    'modal_id' => $modalId
]);

$previewUrl = $block->getUrl($field->getLabelAjaxUrl());
?>
<script>
    require([
        'jquery',
        'uiRegistry',
        'Magento_Ui/js/modal/modal'
    ], function ($, registry, modal) {
        var options = {
            type: 'slide',
            title: '<?= $escaper->escapeJs((string)$gridLabel) ?>',
            responsive: true,
            innerScroll: true,
            buttons: [{
                text: $.mage.__('Close'),
                class: '',
                click: function () {
                    this.closeModal();
                }
            }]
        };

        var $modal = $('#<?= $escaper->escapeJs((string)$modalId) ?>');
        var $iframe = $('#<?= $escaper->escapeJs((string)$modalId) ?> iframe');
        var $input = $('#<?= $escaper->escapeJs((string)$fieldName) ?>');
        var $preview = $('#<?= $escaper->escapeJs((string)$fieldName) ?>-preview');
        var popup = modal(options, $modal);

        $(".<?= $escaper->escapeJs((string)$fieldName) ?>-search-modal-open").on('click', function () {
            $modal.modal("openModal");
            $iframe.attr('src', '<?= $escaper->escapeJs((string)$searchAjaxUrl) ?>');
        });

        $input.on('change', function (event) {
            const previewUrl = '<?= $escaper->escapeJs((string)$previewUrl) ?>' + '?id=' + event.target.value;

            $.ajax({
                url: previewUrl,
                data: {form_key: window.FORM_KEY},
                type: 'POST',
                dataType: 'json',
            }).done(function (data) {
                $preview.html(data.text);
            });
        });

        window.addEventListener('simple_search_grid.modal.close', function (event) {
            if (event.detail.modalId !== '<?= $escaper->escapeJs((string)$modalId) ?>') {
                return;
            }

            popup.closeModal();
        });

        window.addEventListener('simple_search_grid.value.change', function (event) {
            const itemId = event.detail.itemId;
            const fieldId = event.detail.fieldId;
            if ($input.attr('id') === fieldId) {
                $input.val(itemId).trigger('change');
            }
        });

        window.addEventListener('simple_search_grid.search', function (event) {
            const searchUrl ='<?= $escaper->escapeJs($block->getUrl($field->getSearchAjaxUrl(), [
                'modal_id' => $modalId,
                'field_id' => $fieldName,
            ])) ?>' + 'search/' + event.detail.search + '/';
            $iframe.attr('src', searchUrl);
        });

        <?php if (!empty($provider) && !empty($fieldName)): ?>
        const component = registry.get('<?= $escaper->escapeJs((string)$provider) ?>');
        const $field = $('#<?= $escaper->escapeJs((string)$fieldName) ?>');
        if ($field) {
            $field.val(component.data.<?= $escaper->escapeJs((string)$fieldName) ?>);
            $field.change(function () {
                component.data.<?= $escaper->escapeJs((string)$fieldName) ?> = $field.val();
            });
            $field.trigger("change");
        } else {
            console.warning('Field ID "<?= $escaper->escapeJs((string)$fieldName) ?>" does not exist');
        }
        <?php endif; ?>
    });
</script>
